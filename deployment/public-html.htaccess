<IfModule mod_headers.c>
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Never expose dotfiles, credentials, backup files or executable uploads.
    # .well-known remains available for certificate/domain verification.
    RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L,NC]
    RewriteRule \.(?:sql|sqlite3?|bak|log|ya?ml|lock|ini|sh|ps1)$ - [F,L,NC]
    RewriteRule ^(?!index\.php$).*\.(?:php[0-9]?|phtml|phar)(?:/|$) - [F,L,NC]

    # The shared host serves the Laravel project root as public_html.
    # Deny application source and development files before routing requests.
    RewriteRule ^(?:app|bootstrap|config|database|resources|routes|tests|vendor|node_modules|deployment|scripts)(?:/|$) - [F,L,NC]
    RewriteRule ^(?:artisan|composer\.(?:json|lock)|package(?:-lock)?\.json|phpunit\.xml|vite\.config\.js|postcss\.config\.js|tailwind\.config\.js|jsconfig\.json|README\.md|AGENTS\.md)$ - [F,L,NC]

    # Only the root front controller is public. Internal /storage rewrites below
    # are allowed; direct /public requests are not a second copy of the site.
    RewriteCond %{THE_REQUEST} \s/+public(?:[/?\s]) [NC]
    RewriteRule ^ - [F,L]

    RewriteCond %{HTTP_HOST} !^devsprendimai\.lt$ [NC,OR]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://devsprendimai.lt%{REQUEST_URI} [R=301,L,NE]

    RewriteCond %{THE_REQUEST} \s/+index\.php(?:[?\s]) [NC]
    RewriteRule ^index\.php$ / [R=301,L]

    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
